<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing is backed up or transferred to a new device. The app password is bound to
  this device's Keystore and would not survive the move anyway; copying the rest would
  only spread a credential store that cannot be opened.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
